# Local PostgreSQL configuration for Docker Compose and API database scripts
POSTGRES_DB=scoutiq
POSTGRES_USER=scoutiq
POSTGRES_PASSWORD=scoutiq
POSTGRES_PORT=5432

# API service configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
SCOUTIQ_APP_VERSION=local
SCOUTIQ_DATA_MODE=fpl
SCOUTIQ_TRUST_PROXY=

# Abuse and cost limits (defaults shown; counts are per 15 minutes unless noted)
# Planning POSTs from all callers together
SCOUTIQ_GLOBAL_PLANNING_LIMIT=900
# Public FPL team imports from all callers together
SCOUTIQ_GLOBAL_IMPORT_LIMIT=150
# Paid explanation-provider calls per UTC day; further requests use the free fallback
SCOUTIQ_AGENT_DAILY_LIMIT=200
# Projection runs kept after each refresh
SCOUTIQ_PREDICTION_RUNS_KEPT=30

# API database connection
DATABASE_URL=postgresql://scoutiq:scoutiq@localhost:5432/scoutiq
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Ingestion defaults
FPL_SEASON=

# API explanation agent
SCOUTIQ_AGENT_ENABLED=false
SCOUTIQ_AGENT_PROVIDER=auto
SCOUTIQ_AGENT_TIMEOUT_MS=10000
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=

# Smoke-test targets
SCOUTIQ_API_URL=http://localhost:3001
SCOUTIQ_WEB_URL=http://localhost:3000
SCOUTIQ_SMOKE_TIMEOUT_MS=5000
SCOUTIQ_SMOKE_REQUIRE_READY=0
