{
  "name": "@fpl-optimizer/api",
  "version": "1.0.0",
  "description": "ScoutIQ API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start:migrate": "node dist/db/migrate.js && node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:load:fpl": "tsx src/db/load-fpl.ts",
    "db:load:predictions": "tsx src/db/load-predictions.ts",
    "ingest:fpl": "tsx src/ingestion/run.ts",
    "ingest:fpl:history": "tsx src/ingestion/run-history.ts",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "8.7.4",
    "express-slow-down": "3.1.1",
    "helmet": "^7.1.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
